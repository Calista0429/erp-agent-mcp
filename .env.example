# Copy to .env and fill in the passwords, or run `npm run init-env` to generate them.
# .env is git-ignored. docker compose reads the same file.

# Superuser password for the local Postgres container (used by `npm run setup` only)
POSTGRES_PASSWORD=
# Password for erp_app, the non-owner role the MCP server and CLIs connect as
ERP_APP_PASSWORD=

PGHOST=localhost
PGPORT=55432
PGDATABASE=erp

# Alternatively, full connection URLs (e.g. a hosted database) take precedence:
# DATABASE_URL=
# ADMIN_DATABASE_URL=
